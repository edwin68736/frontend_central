# URL base del API backend (Go Fiber)
# Desarrollo: proxy Vite redirige /api -> localhost:3000
# Producción: OBLIGATORIO poner la URL absoluta del backend (no dejar relativo /api)
#
# Desarrollo:
#   VITE_API_URL=http://localhost:3000/api
#   o vacío para usar /api con proxy
#
# Producción (app.tukifac.com llamando a api.tukifac.com):
#   VITE_API_URL=https://api.tukifac.com/api
#
# Si en producción no defines esto, el build usará '/api' y las peticiones irán a
# app.tukifac.com/api (dominio del frontend) en vez de api.tukifac.com/api.
VITE_API_URL=http://localhost:3000/api

# Dominio raíz de tenants (NO es el host del panel central).
# Producción: tukifac.com → https://{slug}.tukifac.com
# Desarrollo: sin definir → {slug}.localhost:5173 (frontend tenant local)
# VITE_ROOT_DOMAIN=tukifac.com
