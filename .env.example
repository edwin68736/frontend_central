# =============================================================================
# Frontend Central — Panel superadmin SaaS (copiar según entorno)
#   .env.development  → npm run dev
#   .env.production   → npm run build (deploy en app.tukifac.com)
# =============================================================================

# ── DESARROLLO LOCAL ───────────────────────────────────────────────
VITE_API_URL=http://localhost:3000/api

# ── PRODUCCIÓN (tukifac.com) — copiar a .env.production ─────────────
#
# Panel central SIEMPRE llama al host api (no usa subdominio tenant):
# VITE_API_URL=https://api.tukifac.com/api
#
# Dominio raíz para enlaces a tenants en la UI (alta empresa, etc.):
# VITE_ROOT_DOMAIN=tukifac.com
#
# URLs resultantes:
#   Panel central:  https://app.tukifac.com
#   API backend:    https://api.tukifac.com/api
#   Tenant demo:    https://demo.tukifac.com
#   Tenant X:       https://{slug}.tukifac.com
