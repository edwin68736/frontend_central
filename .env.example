# URL base del API backend (Go Fiber)
# Desarrollo: proxy Vite redirige /api -> localhost:3000
# Producción: OBLIGATORIO poner la URL absoluta del backend (no dejar relativo /api)
#
# Desarrollo:
#   VITE_API_URL=http://localhost:3000/api
#   o vacío para usar /api con proxy
#
# Producción (app.tukifac.cloud llamando a api.tukifac.cloud):
#   VITE_API_URL=https://api.tukifac.cloud/api
#
# Si en producción no defines esto, el build usará '/api' y las peticiones irán a
# app.tukifac.cloud/api (dominio del frontend) en vez de api.tukifac.cloud/api.
VITE_API_URL=http://localhost:3000/api

# Dominio del frontend de tenants (para construir URLs al hacer clic en el slug).
# Producción: app.tukifac.cloud → https://slug.app.tukifac.cloud
# Desarrollo: localhost:5173 → http://slug.localhost:5173
# Si no se define, se usa window.location.hostname cuando no es localhost, o app.tukifac.cloud por defecto.
# VITE_APP_DOMAIN=app.tukifac.cloud
